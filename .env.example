# ==============================================================================
# KALPA - Master Environment Configuration Template (.env.example)
# Project: AI-Powered Hyper-Local Livelihood & Business Advisory Platform
# Note: Copy this file to .env at the repository root and customize credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (React + Vite)
# ------------------------------------------------------------------------------
# URL pointing to the Node.js API Gateway
VITE_API_GATEWAY_URL=http://localhost:3000/api

# ------------------------------------------------------------------------------
# 2. NODE.JS API GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Downstream URL to the Python FastAPI AI backend
AI_SERVICE_URL=http://localhost:8000
# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. FASTAPI AI SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 4. DATABASE & SPATIAL (PostgreSQL 16 + PostGIS + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kalpa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kalpa
POSTGIS_ENABLED=true
PGVECTOR_ENABLED=false

# ------------------------------------------------------------------------------
# 5. PRIMARY LLM PROVIDER (Groq / OpenAI)
# ------------------------------------------------------------------------------
# Options: "groq" (recommended for ultra-low latency & open models) or "openai"
LLM_PROVIDER=groq

# Groq Configuration (Ultra-fast inference for Qwen / Llama models)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Configuration (Alternative provider)
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 6. SARVAM AI (Indic Multilingual Voice STT & LLM)
# ------------------------------------------------------------------------------
# Get your API key from https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
# Indic Speech-to-Text model (saaras:v4 supports 10+ Indian languages)
SARVAM_STT_MODEL=saaras:v4
# Sarvam Indic LLM model for localized vernacular reasoning
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_LLM_ENABLED=true
SARVAM_LLM_ENDPOINT=https://api.sarvam.ai/v1/chat/completions

# ------------------------------------------------------------------------------
# 7. OPTIONAL SERVICES & EMBEDDINGS
# ------------------------------------------------------------------------------
INDICTRANS_ENABLED=false
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
