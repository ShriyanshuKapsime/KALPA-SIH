# ==============================================================================
# KALPA - Environment Configuration Template
# Project: AI-Powered Hyper-Local Livelihood & Business Advisory Platform
# Note: Copy this file to .env and populate with actual credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_GATEWAY_URL=http://localhost:3000/api

# ------------------------------------------------------------------------------
# 2. NODE.JS API GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. FASTAPI AI SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 4. DATABASE & SPATIAL (PostgreSQL + PostGIS + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kalpa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kalpa
POSTGIS_ENABLED=true
# Set to true when pgvector is installed for future RAG phase
PGVECTOR_ENABLED=false

# ------------------------------------------------------------------------------
# 5. PHASE 1 AI / NLP & SPEECH-TO-TEXT PROVIDERS (Placeholder for future phases)
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your_llm_api_key_here

# Sarvam AI (for Indic Multilingual STT & Voice Intake)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v1

# Optional Multilingual Translation Service
INDICTRANS_ENABLED=false

# ------------------------------------------------------------------------------
# 6. RAG & VECTOR EMBEDDING PREPARATION
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
