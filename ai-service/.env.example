# ==============================================================================
# KALPA AI SERVICE - Environment Configuration Template
# ==============================================================================

# Server Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL + PostGIS + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kalpa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kalpa
POSTGIS_ENABLED=true
PGVECTOR_ENABLED=false

# LLM Providers (Groq / OpenAI)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o

# Sarvam AI (Indic Multilingual Voice STT & Indic LLM)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v4
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_LLM_ENABLED=true
SARVAM_LLM_ENDPOINT=https://api.sarvam.ai/v1/chat/completions

# Multilingual Translation & Embeddings
INDICTRANS_ENABLED=false
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
